<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #e8e8e8; -fx-border-color: #cccccc; -fx-border-width: 0 0 2 0;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dam.audiodigital_tfg.MetronomeController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>
        <Button fx:id="playButton" mnemonicParsing="false" onAction="#togglePlay" prefHeight="45.0" prefWidth="110.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="▶ PLAY" />

        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label fx:id="bpmLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="BPM: 120" />
                <Slider fx:id="bpmSlider" max="240.0" min="40.0" prefWidth="250.0" showTickLabels="true" showTickMarks="true" value="120.0" />
            </children>
        </VBox>

        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Ritmo Cruzado" />
                <ComboBox fx:id="polyComboBox" prefWidth="130.0" style="-fx-cursor: hand;" />
            </children>
        </VBox>
    </children>
</HBox>